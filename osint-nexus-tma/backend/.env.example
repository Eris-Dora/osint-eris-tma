# Токен вашего бота от @BotFather
BOT_TOKEN=1234567890:AAH_ваш_токен_здесь

# Прямая HTTPS-ссылка на ваш фронтенд (GitHub Pages / Vercel)
WEBAPP_URL=https://ваш-логин.github.io/osint-nexus-tma/

# Порт для облачного сервера (Render/Koyeb подставляют его автоматически)
PORT=8000

# Разрешенные источники для CORS (через запятую или * для публичного доступа с WebApp)
CORS_ORIGINS=*
